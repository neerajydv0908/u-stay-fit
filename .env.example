# Copy to .env. Never put .env on GitHub.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Random string of at least 32 characters; encrypts two-factor secrets. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production; a development-only value is used when empty.
APP_SECRET=
# To rotate APP_SECRET: put the OLD value here, the NEW value in APP_SECRET, restart. Two-factor
# secrets are re-encrypted with the new key as people sign in; remove this after a few weeks.
# APP_SECRET_PREVIOUS=
# Empty = a real, embedded PostgreSQL engine (PGlite) for local learning only.
# Production requires a separate PostgreSQL server and DATABASE_URL.
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/u-stay-fit
# Development/test only: raise the per-address sign-in allowance (ignored in production).
# AUTH_RATE_LIMIT=1000
DATABASE_SSL=false
# Email for confirmation links, password resets, and security notices. Configure ONE transport:
#   RESEND_API_KEY  (https://resend.com)  or  SMTP_URL=smtps://user:password@smtp.example.com:465
# Leave both empty in development and messages are printed in the server terminal instead.
# Production refuses to start without one of them plus EMAIL_FROM.
EMAIL_FROM="U Stay Fit <no-reply@your-domain.example>"
RESEND_API_KEY=
SMTP_URL=
# Where the server emails a security alert when the last hour shows unusual volumes of failed
# sign-ins, code guesses, sign-ups, resets, or deletions (thresholds in server/maintenance.js).
# Alerts are also written to the server log as {"event":"security_alert"} lines.
SECURITY_ALERT_EMAIL=
# How many reverse proxies sit in front of Express (default: 1 in production, none otherwise).
# Ask your host; a wrong value breaks rate limiting. Also accepts "loopback" or an address list.
# With the included Compose deployment: 1 (Caddy only) or 2 once Cloudflare is proxying too.
TRUST_PROXY=
# New passwords are checked against Have I Been Pwned's breached-password list (k-anonymity;
# the password never leaves the server). Set to false to disable.
PASSWORD_BREACH_CHECK=true
# Obtain these in each provider's developer console. Keep secrets on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v23.0
# Optional local Docker PostgreSQL. Choose a local-only password before using compose.yml.
# Production Compose uses separate random mounted secret files instead.
POSTGRES_PASSWORD=
# Deployment-only: fill on the server, never in browser code.
SITE_DOMAIN=
# Use DATABASE_SSL=true for managed PostgreSQL. Remove sslmode and other SSL URL parameters.
# DATABASE_CA_FILE=/path/to/provider-ca.pem
# Only the isolated Compose database network may use this explicit exception:
DATABASE_ALLOW_INSECURE_PRIVATE=false
# File alternatives avoid putting secrets directly in container environment variables:
# DATABASE_PASSWORD_FILE=/run/secrets/db_app_password
# APP_SECRET_FILE=/run/secrets/app_secret
# Set ONLY the value or its _FILE alternative, never both.
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
# FACEBOOK_CLIENT_SECRET_FILE=/run/secrets/facebook_client_secret
# Backups use a passphrase file (chmod 600); never put the passphrase on a command line.
BACKUP_PASSPHRASE_FILE=
