https://{$SITE_DOMAIN} {
  tls {
    protocols tls1.2 tls1.3
  }
  encode zstd gzip
  # Do not advertise the proxy software; bound request bodies before they reach the app.
  header -Server
  request_body {
    max_size 1MB
  }
  reverse_proxy app:3001
}

# The www spelling redirects to the bare domain (both names need an A record).
https://www.{$SITE_DOMAIN} {
  redir https://{$SITE_DOMAIN}{uri} permanent
}
