{
  "name": "u-stay-fit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:migrate": "node server/migrate.js",
    "test:e2e": "playwright test",
    "format": "prettier --write client server shared tests scripts vite.config.js playwright.config.js",
    "photos:fetch": "node scripts/fetch-photos.mjs",
    "account": "node server/admin.js",
    "test:postgres": "node scripts/test-postgres.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "embedded-postgres": "17.10.0-beta.17",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
